<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="All_in_One_Messenger.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:All_in_One_Messenger.Pages"
    xmlns:models="using:All_in_One_Messenger.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer Padding="32 24">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">

                <!-- Page Title -->
                <TextBlock Text="Cài đặt" FontSize="28" FontWeight="SemiBold"/>

                <!-- ── Notification ── -->
                <Border Padding="16 12"
                        CornerRadius="8"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="2">

                        <TextBlock Text="Thông báo"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Kiểu thông báo khi có tin nhắn mới."
                                   FontSize="13"
                                   Padding="12 0"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <RadioButtons x:Name="NotificationModeGroup"
                                      MaxColumns="2"
                                      Margin="12 0"
                                      SelectionChanged="NotificationModeGroup_SelectionChanged"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <RadioButton x:Name="RadioToast" Tag="Toast" Margin="0 0 36 0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Thông báo nổi" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Hiển thị popup thông báo kèm nội dung tin nhắn."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RadioSilent" Tag="Silent">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Thông báo ẩn" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Chỉ hiện số badge trên taskbar, không hiện popup."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- ── Custom chat server ── -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="20 16"
                        CornerRadius="8"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">

                        <TextBlock Text="Chat server tùy chỉnh"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Thêm bất kỳ ứng dụng chat web nào vào menu chính."
                                   FontSize="13"
                                   Padding="12 0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- List of saved servers -->
                        <ListView x:Name="ServerListView"
                                  Padding="4 0"
                                  AllowDrop="True"                            
                                  CanDragItems="True"
                                  SelectionMode="None"  
                                  CanReorderItems="True"
                                  ItemsSource="{x:Bind CustomServers}"
                                  DragItemsCompleted="ServerListView_DragItemsCompleted">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4 4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomServerInfo">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Server icon -->
                                        <Border Grid.Column="0"
                                                Width="36" 
                                                Height="36"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <FontIcon x:Name="GlyphIcon"
                                                          x:Load="{x:Bind IsGlyphIcon}"
                                                          Glyph="{x:Bind IconName, Mode=OneWay}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="16"
                                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                                <Image x:Name="ImageIcon"
                                                       x:Load="{x:Bind IsImageIcon}"
                                                       Width="28" Height="28"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Source="{x:Bind ImageSource, Mode=OneWay}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Name + URL -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{x:Bind Url, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Column="2"
                                                    Spacing="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center">
                                            <Button Tag="{x:Bind Id}"
                                                    Height="36"
                                                    Click="EditServer_Click"
                                                    ToolTipService.ToolTip="Chỉnh sửa server"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Visibility="{x:Bind GetCustomVisibility(Id)}">
                                                <FontIcon FontFamily="Segoe MDL2 Assets"
                                                          Glyph="&#xE70F;"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Button>
                                            <Button Tag="{x:Bind Id}"
                                                    Height="36"
                                                    Click="DeleteServer_Click"
                                                    ToolTipService.ToolTip="Xóa server"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Visibility="{x:Bind GetCustomVisibility(Id)}">
                                                <FontIcon FontFamily="Segoe MDL2 Assets"
                                                          Glyph="&#xE74D;"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </Button>

                                            <ToggleButton Tag="{x:Bind Id}"
                                                          x:Name="HiddenServerToggle"
                                                          Click="HiddenServerToggle_Click"
                                                          IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource TitleBarToggleButtonStyle}"
                                                          Visibility="{x:Bind GetDefaultVisibility(Id)}"
                                                          ToolTipService.ToolTip="Ẩn/hiện server ">
                                                <FontIcon x:Name="HiddenIcon"
                                                          FontSize="16"
                                                          Glyph="{x:Bind GetIconForServer(IsEnabled), Mode=OneWay}"
                                                          FontFamily="Segoe MDL2 Assets"/>
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Add button -->
                        <Button x:Name="AddServerButton"
                                Margin="9 0 0 0 "
                                Click="AddServer_Click"
                                Style="{ThemeResource DefaultButtonStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="Thêm server"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ── Check update ── -->
                <Border Padding="16 12"
                        CornerRadius="8"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <StackPanel Spacing="2">

                        <TextBlock Text="Giới thiệu"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Padding="12 0"
                                       x:Name="VersionText"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <!-- Add button -->
                            <Button Grid.Column="1"
                                    x:Name="CheckUpdate"
                                    Click="CheckUpdate_Click"
                                    Style="{ThemeResource DefaultButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets"
                                          Glyph="&#xE895;"
                                          FontSize="14"/>
                                    <TextBlock Text="Kiểm tra cập nhật" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Opacity="0.6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99">
            <ProgressRing x:Name="CheckUpdateRing"
                          IsActive="False"
                          Width="48" Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>